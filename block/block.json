{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pdf-forge/embed",
	"title": "PDF Forge",
	"category": "media",
	"icon": "media-document",
	"description": "Embed a PDF file directly in your post with an inline viewer.",
	"keywords": [ "pdf", "embed", "document", "viewer", "file" ],
	"textdomain": "pdf-forge",
	"editorScript": "pdf-forge-editor",
	"style": "pdf-forge",
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"anchor": true
	},
	"attributes": {
		"id": { "type": "number", "default": 0 },
		"url": { "type": "string", "default": "" },
		"height": { "type": "number", "default": 600 },
		"toolbar": { "type": "boolean", "default": true },
		"title": { "type": "string", "default": "" }
	}
}
